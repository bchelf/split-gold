---
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  text: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const { title, text, primary, secondary } = Astro.props;
---

<section class="bg-olive-900 py-14 text-white">
  <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-4 sm:px-6 lg:flex-row lg:items-center lg:px-8">
    <div class="max-w-2xl">
      <h2 class="font-serif text-3xl">{title}</h2>
      <p class="mt-3 text-olive-100">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={withBase(primary.href)} class="rounded-full bg-terracotta-600 px-6 py-3 font-semibold text-white hover:bg-terracotta-700">{primary.label}</a>
      {secondary && <a href={withBase(secondary.href)} class="rounded-full border border-white/70 px-6 py-3 font-semibold text-white hover:bg-white/10">{secondary.label}</a>}
    </div>
  </div>
</section>
