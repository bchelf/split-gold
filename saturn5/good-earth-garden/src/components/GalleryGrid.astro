---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {items.map((item) => (
    <figure class="overflow-hidden rounded-2xl">
      <Image src={item.image} alt={item.alt} widths={[480, 900, 1280]} sizes="(max-width: 1024px) 50vw, 25vw" class="h-64 w-full object-cover transition duration-500 hover:scale-105" />
    </figure>
  ))}
</div>
