---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  subtitle: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { image, imageAlt, title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<section class="relative isolate overflow-hidden">
  <Image src={image} alt={imageAlt} widths={[768, 1280, 1920]} sizes="100vw" class="h-[68vh] min-h-[520px] w-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-r from-olive-950/80 via-olive-900/60 to-transparent"></div>
  <div class="absolute inset-0 flex items-center">
    <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl text-white">
        <p class="mb-3 font-semibold uppercase tracking-[0.22em] text-sand-200">Little Rock, Arkansas</p>
        <h1 class="font-serif text-4xl leading-tight sm:text-5xl lg:text-6xl">{title}</h1>
        <p class="mt-5 max-w-2xl text-lg text-sand-100 sm:text-xl">{subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={primaryCta.href} class="rounded-full bg-terracotta-600 px-6 py-3 text-base font-semibold text-white hover:bg-terracotta-700">{primaryCta.label}</a>
          {secondaryCta && <a href={secondaryCta.href} class="rounded-full border border-white/70 px-6 py-3 text-base font-semibold text-white hover:bg-white/10">{secondaryCta.label}</a>}
        </div>
      </div>
    </div>
  </div>
</section>
