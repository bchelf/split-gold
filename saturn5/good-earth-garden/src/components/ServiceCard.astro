---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../utils/paths';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  description: string;
  href: string;
  cta: string;
}

const { image, imageAlt, title, description, href, cta } = Astro.props;
---

<article class="overflow-hidden rounded-2xl border border-olive-200 bg-white shadow-soft">
  <Image src={image} alt={imageAlt} widths={[480, 720, 1024]} sizes="(max-width: 1024px) 100vw, 50vw" class="h-56 w-full object-cover" />
  <div class="space-y-4 p-6">
    <h3 class="font-serif text-2xl text-olive-900">{title}</h3>
    <p class="text-base leading-relaxed text-olive-800">{description}</p>
    <a href={withBase(href)} class="inline-flex rounded-full bg-olive-800 px-5 py-2.5 text-sm font-semibold text-white hover:bg-olive-900">{cta}</a>
  </div>
</article>
