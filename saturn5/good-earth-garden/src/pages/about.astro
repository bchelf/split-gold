---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import { aboutSummary, awardsHighlights, communitySupport, historyHighlights } from '../data/site';
import { Image } from 'astro:assets';

import historyImage from '../assets/images/garden-center/aerial-garden-center.jpg';
---

<Layout
  title="About The Good Earth Garden Center | History and Awards"
  description="Learn about The Good Earth Garden Center history since 1974, its mission, and major awards in Arkansas and the garden center industry."
  path="/about/"
>
  <Header />
  <main>
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h1 class="font-serif text-4xl text-olive-900 sm:text-5xl">About The Good Earth Garden Center</h1>
          {aboutSummary.map((line) => <p class="mt-4 text-olive-800">{line}</p>)}
        </div>
        <Image
          src={historyImage}
          alt="The Good Earth Garden Center campus"
          widths={[768, 1280, 1600]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="h-full min-h-80 w-full rounded-2xl object-cover shadow-soft"
        />
      </div>
    </section>

    <section class="bg-olive-50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl text-olive-900">History Highlights</h2>
        <ul class="mt-6 grid gap-3">
          {historyHighlights.map((item) => <li class="rounded-xl border border-olive-200 bg-white p-4 text-olive-800">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-3xl text-olive-900">Community Involvement</h2>
      {communitySupport.map((line) => <p class="mt-4 max-w-4xl text-olive-800">{line}</p>)}
      <a href="https://thegoodearthgarden.com/about-us/community-involvement/" class="mt-6 inline-flex rounded-full border border-olive-800 px-5 py-2.5 font-semibold text-olive-900 hover:bg-olive-100">View Community Projects</a>
    </section>

    <section class="bg-olive-50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl text-olive-900">Recognition</h2>
        <p class="mt-4 max-w-3xl text-olive-800">The Good Earth highlights recurring recognition from Arkansas publications and industry lists, including Top 100 Independent Garden Centers in North America.</p>
        <ul class="mt-6 grid gap-3">
          {awardsHighlights.map((item) => <li class="rounded-xl border border-olive-200 bg-white p-4 text-olive-800">{item}</li>)}
        </ul>
      </div>
    </section>

    <CTASection
      title="Work With a Long-Standing Local Team"
      text="Connect with The Good Earth team for landscaping support, garden center guidance, and seasonal planning."
      primary={{ label: 'Contact The Good Earth', href: '/contact/' }}
      secondary={{ label: 'Explore Landscaping', href: '/landscaping/' }}
    />
  </main>
  <Footer />
</Layout>
