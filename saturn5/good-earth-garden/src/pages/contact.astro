---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/site';
import { withBase } from '../utils/paths';

---

<Layout
  title="Contact The Good Earth Garden Center | Little Rock, AR"
  description="Contact The Good Earth Garden Center at 15601 Cantrell Road in Little Rock, call 501.868.4666, or email wecare@thegoodearthgarden.com."
  path="/contact/"
>
  <Header />
  <main class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="font-serif text-4xl text-olive-900 sm:text-5xl">Contact The Good Earth Garden Center</h1>
    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <section class="rounded-2xl border border-olive-200 bg-white p-6 shadow-soft">
        <h2 class="text-2xl text-olive-900">Visit or Call</h2>
        <p class="mt-4 text-olive-800">{business.address.street}<br />{business.address.city}, {business.address.region} {business.address.postalCode}</p>
        <p class="mt-3 text-olive-800"><a href={business.phoneHref} class="font-semibold text-olive-900 hover:underline">{business.phoneDisplay}</a></p>
        <p class="mt-2 text-olive-800"><a href={`mailto:${business.email}`} class="font-semibold text-olive-900 hover:underline">{business.email}</a></p>
        <p class="mt-4 text-olive-800">Good Earth - Great Experience is our goal.</p>

        <h3 class="mt-8 text-xl text-olive-900">Current Hours</h3>
        <p class="mt-3 text-olive-800">{business.hours.seasonal}</p>
        <p class="mt-2 text-olive-800">{business.hours.regular}</p>
        <p class="mt-2 text-olive-800">Sunday hours are seasonal, and severe weather can affect daily hours.</p>

        <h3 class="mt-8 text-xl text-olive-900">Holiday Notes</h3>
        <p class="mt-3 text-olive-800">Closed on Easter, July 4th, Labor Day, Thanksgiving Day, Christmas Day, and New Year's Day. The business may close early on select holidays.</p>
        <p class="mt-2 text-olive-800">Check social channels for early-closing notices during major holidays and severe weather.</p>

        <h3 class="mt-8 text-xl text-olive-900">Helpful Links</h3>
        <p class="mt-3 text-olive-800"><a class="font-semibold text-olive-900 hover:underline" href={withBase('/landscaping/')}>Landscaping Services</a></p>
        <p class="mt-2 text-olive-800"><a class="font-semibold text-olive-900 hover:underline" href={withBase('/garden-center/')}>Garden Center Inventory</a></p>
        <p class="mt-2 text-olive-800"><a class="font-semibold text-olive-900 hover:underline" href={withBase('/learning-center/')}>Learning Center</a></p>
      </section>

      <section class="overflow-hidden rounded-2xl border border-olive-200 bg-white shadow-soft">
        <img
          src={withBase('/images/garden-center/inventory.jpg')}
          alt="The Good Earth Garden Center in Little Rock"
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </section>
    </div>
  </main>
  <Footer />
</Layout>
