---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import { inventoryExperience, inventoryHighlights } from '../data/site';
import { Image } from 'astro:assets';

import hero from '../assets/images/garden-center/inventory.jpg';
import seasonal from '../assets/images/garden-center/seasonal-decor.jpg';
---

<Layout
  title="Garden Center Inventory | The Good Earth Garden Center"
  description="Explore trees, shrubs, perennials, houseplants, pottery, soil, mulch, and seasonal decor at The Good Earth Garden Center in Little Rock."
  path="/garden-center/"
>
  <Header />
  <main>
    <section class="relative isolate overflow-hidden">
      <Image
        src={hero}
        alt="The Good Earth Garden Center inventory"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="h-[48vh] min-h-[360px] w-full object-cover"
      />
      <div class="absolute inset-0 bg-olive-950/55"></div>
      <div class="absolute inset-0 mx-auto flex max-w-7xl items-center px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl text-white">
          <h1 class="font-serif text-4xl sm:text-5xl">The Good Earth Garden Center Inventory</h1>
          <p class="mt-4 text-lg text-sand-100">A broad selection of plants, pottery, stone, soils, and seasonal products for Central Arkansas gardens and outdoor living.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl text-olive-900">Organized to Make Shopping Easier</h2>
          {inventoryExperience.slice(0, 3).map((line) => <p class="mt-4 text-olive-800">{line}</p>)}
        </div>
        <Image
          src={seasonal}
          alt="Seasonal decor and plant offerings"
          widths={[768, 1280, 1600]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="h-full min-h-80 w-full rounded-2xl object-cover shadow-soft"
        />
      </div>
    </section>

    <section class="bg-olive-50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl text-olive-900">What You Will Find</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {inventoryHighlights.map((item) => <li class="rounded-xl border border-olive-200 bg-white p-4 text-olive-800">{item}</li>)}
        </ul>
        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {inventoryExperience.slice(3).map((line) => <p class="rounded-xl border border-olive-200 bg-white p-4 text-olive-800">{line}</p>)}
        </div>
        <p class="mt-6 text-olive-800">The inventory page also highlights delivery availability and asks customers to call for delivery details.</p>
      </div>
    </section>

    <CTASection
      title="Visit the Garden Center"
      text="Stop by The Good Earth in Little Rock for plants, materials, and local guidance for your next project."
      primary={{ label: 'Get Directions & Hours', href: '/contact/' }}
      secondary={{ label: 'Explore Landscaping', href: '/landscaping/' }}
    />
  </main>
  <Footer />
</Layout>
