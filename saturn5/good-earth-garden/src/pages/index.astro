---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ServiceCard from '../components/ServiceCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import { trustSignals, aboutSummary } from '../data/site';
import { withBase } from '../utils/paths';
import { Image } from 'astro:assets';

import heroLandscape from '../assets/images/hero/hero-landscape.jpg';
import landscapingImage from '../assets/images/landscaping/landscape-services.jpg';
import gardenCenterImage from '../assets/images/garden-center/inventory.jpg';
import outdoorLiving from '../assets/images/landscaping/outdoor-living.jpeg';
import plantsImage from '../assets/images/plants/perennials.jpg';
import aboutImage from '../assets/images/garden-center/aerial-garden-center.jpg';
import project1 from '../assets/images/gallery/project-landscape.jpg';
import project2 from '../assets/images/gallery/project-lighting.jpg';
import project3 from '../assets/images/gallery/project-outdoor-living.jpeg';
import project4 from '../assets/images/gallery/project-ranch-ridge.jpg';
---

<Layout
  title="The Good Earth Garden Center | Landscaping and Garden Center in Little Rock"
  description="The Good Earth Garden Center offers landscape planning, installation, maintenance, irrigation, and a full-service garden center in Little Rock, Arkansas."
  path="/"
>
  <Header />
  <Hero
    image={heroLandscape}
    imageAlt="Customers viewing plants at The Good Earth Garden Center"
    title="Landscape Design, Installation, and a Full-Service Garden Center in Little Rock"
    subtitle="The Good Earth Garden Center helps Central Arkansas homeowners improve outdoor living spaces with professional landscaping and an extensive plant nursery."
    primaryCta={{ label: 'Request a Consultation', href: '/contact/' }}
    secondaryCta={{ label: 'Visit the Garden Center', href: '/garden-center/' }}
  />
  <TrustStrip items={trustSignals} />

  <main>
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-3xl text-olive-900 sm:text-4xl">Choose Your Path</h2>
      <p class="mt-3 max-w-3xl text-olive-800">Whether you are planning a complete landscape renovation or shopping for plants and garden essentials, the team at The Good Earth is ready to help.</p>
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <ServiceCard
          image={landscapingImage}
          imageAlt="Landscape installation by The Good Earth Garden Center"
          title="Landscaping & Design"
          description="Planning, construction, irrigation, lighting, hardscape and maintenance services built around your property and how you live outdoors."
          href="/landscaping/"
          cta="Explore Landscaping"
        />
        <ServiceCard
          image={gardenCenterImage}
          imageAlt="The Good Earth Garden Center inventory area"
          title="Garden Center"
          description="Shop trees, shrubs, perennials, pottery, soil, seasonal color, gift items, and gardening supplies with local guidance from experienced staff."
          href="/garden-center/"
          cta="Browse Garden Center"
        />
      </div>
    </section>

    <section class="bg-white/80 py-16">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
        <div>
          <h2 class="text-3xl text-olive-900 sm:text-4xl">Outdoor Spaces Designed for Real Life</h2>
          <p class="mt-4 text-olive-800">The Good Earth team emphasizes landscapes that are both functional and beautiful. Their process focuses on your goals, traffic flow, maintenance preferences, and long-term value.</p>
          <p class="mt-4 text-olive-800">Services include planting plans, trees and lawn integration, irrigation, landscape lighting, hardscape and outdoor rooms, water features, and maintenance support.</p>
          <a href={withBase('/landscaping/')} class="mt-6 inline-flex rounded-full bg-olive-800 px-5 py-2.5 font-semibold text-white hover:bg-olive-900">View Landscaping Services</a>
        </div>
        <Image
          src={outdoorLiving}
          alt="Outdoor living landscape with stone and plantings"
          widths={[768, 1280, 1600]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="h-full min-h-80 w-full rounded-2xl object-cover shadow-soft"
        />
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-3xl text-olive-900 sm:text-4xl">Project Gallery</h2>
      <p class="mt-3 text-olive-800">Recent project imagery from The Good Earth.</p>
      <div class="mt-8">
        <GalleryGrid
          items={[
            { image: project1, alt: 'Landscape design and installation project' },
            { image: project2, alt: 'Landscape lighting project at dusk' },
            { image: project3, alt: 'Fountain and outdoor landscape feature' },
            { image: project4, alt: 'Aerial view of completed landscape project' },
          ]}
        />
      </div>
      <a href={withBase('/gallery/')} class="mt-6 inline-flex rounded-full bg-olive-800 px-5 py-2.5 font-semibold text-white hover:bg-olive-900">See More Images</a>
    </section>

    <section class="bg-olive-50 py-16">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
        <Image
          src={plantsImage}
          alt="Perennials and plants at The Good Earth"
          widths={[768, 1280, 1600]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="h-full min-h-80 w-full rounded-2xl object-cover shadow-soft"
        />
        <div>
          <h2 class="text-3xl text-olive-900 sm:text-4xl">Garden Center Expertise for Every Season</h2>
          <p class="mt-4 text-olive-800">Inventory is organized by sun needs to make shopping easier, with dedicated areas for sun shrubs, shade shrubs, tree rows, groundcovers, bulk materials, and seasonal color.</p>
          <p class="mt-4 text-olive-800">You will also find pottery, fountains, gift items, and a broad selection of plants for Arkansas gardens.</p>
          <a href={withBase('/garden-center/')} class="mt-6 inline-flex rounded-full bg-olive-800 px-5 py-2.5 font-semibold text-white hover:bg-olive-900">Plan Your Visit</a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl text-olive-900 sm:text-4xl">A Little Rock Business Since 1974</h2>
          {aboutSummary.map((line) => <p class="mt-4 text-olive-800">{line}</p>)}
          <a href={withBase('/about/')} class="mt-6 inline-flex rounded-full bg-olive-800 px-5 py-2.5 font-semibold text-white hover:bg-olive-900">Read Our Story</a>
        </div>
        <Image
          src={aboutImage}
          alt="Aerial view of The Good Earth Garden Center"
          widths={[768, 1280, 1600]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="h-full min-h-80 w-full rounded-2xl object-cover shadow-soft"
        />
      </div>
    </section>

    <CTASection
      title="Start Your Landscape or Garden Project"
      text="Call or visit The Good Earth Garden Center to discuss your landscaping goals, plant selections, and seasonal needs."
      primary={{ label: 'Request a Consultation', href: '/contact/' }}
      secondary={{ label: 'Visit the Garden Center', href: '/garden-center/' }}
    />
  </main>

  <Footer />
</Layout>
