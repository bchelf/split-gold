---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import { landscapingServices, landscapingPopularFeatures, landscapingAllFeatures } from '../data/site';
import { Image } from 'astro:assets';
import { withBase } from '../utils/paths';

import hero from '../assets/images/hero/hero-lighting.jpg';
import feature from '../assets/images/landscaping/ranch-ridge.jpg';
---

<Layout
  title="Landscaping Services | The Good Earth Garden Center"
  description="Landscape planning, construction, hardscape, irrigation, water features, and maintenance services from The Good Earth Garden Center in Little Rock."
  path="/landscaping/"
>
  <Header />
  <main>
    <section class="relative isolate overflow-hidden">
      <Image
        src={hero}
        alt="Landscape lighting and design project"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="h-[48vh] min-h-[360px] w-full object-cover"
      />
      <div class="absolute inset-0 bg-olive-950/55"></div>
      <div class="absolute inset-0 mx-auto flex max-w-7xl items-center px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl text-white">
          <h1 class="font-serif text-4xl sm:text-5xl">Landscaping Services in Little Rock</h1>
          <p class="mt-4 text-lg text-sand-100">From planning through installation and long-term maintenance, The Good Earth builds and supports functional, beautiful outdoor spaces.</p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-2">
        <div>
          <h2 class="text-3xl text-olive-900">Planning, Construction, and Maintenance</h2>
          <p class="mt-4 text-olive-800">The landscaping team highlights more than 250 combined years of experience and focuses on detailed estimates, lifestyle-fit planning, and quality workmanship.</p>
          <p class="mt-4 text-olive-800">Popular project features include hardscape and outdoor rooms, water features, sprinkler systems, and outdoor lighting.</p>
          <a href="https://thegoodearthgarden.com/before-after/" class="mt-6 inline-flex rounded-full border border-olive-800 px-5 py-2.5 font-semibold text-olive-900 hover:bg-olive-100">View Before & After Projects</a>
        </div>
        <Image
          src={feature}
          alt="Completed landscape installation with walkways and planting"
          widths={[768, 1280, 1600]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          class="h-full min-h-80 w-full rounded-2xl object-cover shadow-soft"
        />
      </div>
    </section>

    <section class="bg-olive-50 py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl text-olive-900">Core Services</h2>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {landscapingServices.map((item) => <li class="rounded-xl border border-olive-200 bg-white p-4 text-olive-800">{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
      <h2 class="text-3xl text-olive-900">Most Popular Features</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {landscapingPopularFeatures.map((item) => <li class="rounded-xl border border-olive-200 bg-white p-4 text-olive-800">{item}</li>)}
      </ul>
      <h3 class="mt-10 text-2xl text-olive-900">Additional Feature Options</h3>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {landscapingAllFeatures.map((item) => <li class="rounded-xl border border-olive-200 bg-white p-4 text-olive-800">{item}</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase('/gallery/')} class="rounded-full bg-olive-800 px-5 py-2.5 font-semibold text-white hover:bg-olive-900">See Gallery Images</a>
        <a href="https://thegoodearthgarden.com/before-after/" class="rounded-full border border-olive-800 px-5 py-2.5 font-semibold text-olive-900 hover:bg-olive-100">See Before & After</a>
      </div>
    </section>

    <CTASection
      title="Discuss Your Landscape Project"
      text="Share your goals with The Good Earth team and request a consultation for planning, installation, or maintenance."
      primary={{ label: 'Request a Consultation', href: '/contact/' }}
      secondary={{ label: 'View Project Gallery', href: '/gallery/' }}
    />
  </main>
  <Footer />
</Layout>
