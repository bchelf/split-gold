---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { landscapingServices } from '../../data/site';
---

<Layout
  title="Landscaping Services in Little Rock, AR | The Good Earth Garden Center"
  description="Little Rock landscaping services from The Good Earth Garden Center, including planning, construction, irrigation, lighting, and maintenance."
  path="/services/landscaping-little-rock/"
>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="font-serif text-4xl text-olive-900 sm:text-5xl">Landscaping Services in Little Rock</h1>
    <p class="mt-4 text-olive-800">The Good Earth Garden Center provides full landscape planning, installation, and maintenance support for homes across Little Rock and Central Arkansas.</p>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {landscapingServices.map((service) => <li class="rounded-xl border border-olive-200 bg-white p-4 text-olive-800">{service}</li>)}
    </ul>
  </main>
  <CTASection title="Request Landscape Planning" text="Speak with The Good Earth team about goals, site conditions, and service options for your property." primary={{ label: 'Request a Consultation', href: '/contact/' }} />
  <Footer />
</Layout>
