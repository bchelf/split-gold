---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
---

<Layout
  title="Patio Installation in Little Rock, AR | The Good Earth Garden Center"
  description="Stone patio and outdoor room work as part of landscape planning and construction services from The Good Earth Garden Center in Little Rock."
  path="/services/patio-installation-little-rock/"
>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="font-serif text-4xl text-olive-900 sm:text-5xl">Patio Installation in Little Rock</h1>
    <p class="mt-4 text-olive-800">The Good Earth includes stone patio and hardscape elements within its landscape planning and construction work. Their service pages highlight hardscape and outdoor rooms, paths, stone edging, and related outdoor living features.</p>
    <p class="mt-4 text-olive-800">Landscape features listed by The Good Earth also include fire pits, walkways, stepping stones, and dry stack wall elements that can be paired with patio installations.</p>
  </main>
  <CTASection title="Plan an Outdoor Living Project" text="Request a consultation to discuss patio and hardscape goals for your Little Rock property." primary={{ label: 'Request a Consultation', href: '/contact/' }} />
  <Footer />
</Layout>
